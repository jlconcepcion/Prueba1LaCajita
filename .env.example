# LaCajitaTV Environment Variables
# Copy to .env and fill with your values

# Public variables (visible in bundle, must be safe)
VITE_APP_ID=141

# API Configuration
# Note: Ideally these should be accessed via a backend proxy
# to keep production endpoints hidden
VITE_API_BASE=https://tvappbuilder.com/API/V1/embed
VITE_API_VERSION=1.0.0
VITE_API_TIMEOUT=10000

# For production:
# 1. Use a backend API proxy
# 2. Never commit real .env files
# 3. Store production credentials in secure CI/CD secrets
# 4. Use environment-specific .env files (.env.production, .env.staging)
